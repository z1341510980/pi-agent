{
  "name": "desktop",
  "version": "0.1.0",
  "description": "An Electron application with React, TanStack Query, and CopilotKit",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.5.1",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run --environment jsdom",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "rebuild:sqlite": "node scripts/rebuild-sqlite.mjs",
    "build:server": "pnpm --filter agent-server build:bytenode && pnpm --filter agent-server collect-deps",
    "build": "npm run typecheck && npm run rebuild:sqlite && npm run build:server && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@copilotkit/react-core": "^1.59.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^3.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@repo/config": "workspace:*",
    "@repo/protocol": "workspace:*",
    "@repo/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.3",
    "@testing-library/react": "^16.3.2",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "electron-updater": "^6.3.9",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "framer-motion": "^12.40.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.20.0",
    "prettier": "^3.7.4",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-hotkeys-hook": "^5.3.2",
    "react-markdown": "^9.0.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tiptap-markdown": "^0.9.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.9",
    "zod": "^4.4.3",
    "zundo": "^2.1.0",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "@svar-ui/react-gantt": "2.7.1",
    "@use-gesture/react": "^10.3.1",
    "d3-force": "^3.0.0"
  }
}
