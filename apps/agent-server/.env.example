# ============================================
# Agent Server 环境变量模板
# 复制为 .env 并填写实际值
# ============================================

# 运行环境
NODE_ENV=development

# 服务地址
HOST=127.0.0.1
PORT=3900

# CORS 配置
CORS_ORIGIN=*

# Agent 限制
AGENT_MAX_LOOPS=30
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_CONTEXT_TOKENS=120000

# 注意：LLM Provider 配置（API Key、模型等）由前端设置页面配置，
# 不在环境变量中配置。请启动后在设置 → Provider 管理中添加。

# ===== Web Search =====
# SearXNG 实例地址（docker compose up 后默认本地 8888）
SEARXNG_URL=http://localhost:8888
# 正文抓取超时（毫秒）
WEB_SEARCH_FETCH_TIMEOUT=8000
# 单次搜索抓取正文并发数
WEB_SEARCH_CONCURRENCY=3
# 正文截断字数
WEB_SEARCH_MAX_CONTENT_CHARS=2000
