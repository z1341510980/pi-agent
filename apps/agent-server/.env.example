# ============================================
# Agent Server 环境变量模板
# 复制为 .env 并填写实际值
# ============================================

# 运行环境
NODE_ENV=development

# 服务地址
HOST=127.0.0.1
PORT=3900

# CORS 配置
CORS_ORIGIN=*

# Agent 限制
AGENT_MAX_LOOPS=30
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_CONTEXT_TOKENS=120000

# 注意：LLM Provider 配置（API Key、模型等）由前端设置页面配置，
# 不在环境变量中配置。请启动后在设置 → Provider 管理中添加。
