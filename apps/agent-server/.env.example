# ============================================
# Agent Server 环境变量模板
# 复制为 .env 并填写实际值
# ============================================

# 运行环境
NODE_ENV=development

# 服务地址
HOST=127.0.0.1
PORT=3900

# CORS 配置
CORS_ORIGIN=*

# Agent 限制
AGENT_MAX_LOOPS=30
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_CONTEXT_TOKENS=120000

# LLM 配置
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=your-api-key-here
