{
  "name": "agent-server",
  "version": "0.1.0",
  "description": "AI Agent 后端服务，基于 Fastify 提供 AG-UI 协议与 CopilotKit 运行时接口",
  "main": "dist/index.js",
  "scripts": {
    "check-native-abi": "node scripts/check-native-abi.mjs",
    "dev": "pnpm check-native-abi && tsx watch --tsconfig tsconfig.tsx.json src/index.ts",
    "dev:hot": "pnpm check-native-abi && tsx --tsconfig tsconfig.tsx.json src/index.ts",
    "build": "tsc",
    "build:tsdown": "tsdown",
    "build:bytenode": "node scripts/build-bytenode.mjs",
    "collect-deps": "node scripts/collect-server-deps.mjs",
    "start": "node dist/index.js",
    "start:bytenode": "node dist/loader.cjs",
    "reconcile:matrix": "tsx --tsconfig tsconfig.tsx.json scripts/reconcile-matrix-projection.ts",
    "backfill:ledger": "tsx --tsconfig tsconfig.tsx.json scripts/backfill-ledger-projection.ts",
    "cleanup:dangling": "tsx --tsconfig tsconfig.tsx.json scripts/cleanup-dangling-ledger-refs.ts",
    "test": "node scripts/vitest-watchdog.mjs run",
    "test:direct": "vitest run"
  },
  "keywords": [
    "fastify",
    "ag-ui",
    "copilotkit",
    "ai-agent"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ag-ui/client": "0.0.53",
    "@ag-ui/core": "^0.0.56",
    "@copilotkit/runtime": "^1.59.5",
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/websocket": "^11.2.0",
    "@llblab/pi-actors": "0.47.0",
    "@mozilla/readability": "^0.6.0",
    "@repo/config": "workspace:*",
    "@repo/protocol": "workspace:*",
    "@repo/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "pi-subagents": "0.49.0",
    "turndown": "^7.2.4",
    "typebox": "^1.3.0",
    "undici": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.20",
    "@types/turndown": "^5.0.6",
    "bytenode": "^1.5.7",
    "esbuild": "^0.24.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
