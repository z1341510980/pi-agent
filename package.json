{
  "name": "wenlang-agent",
  "version": "0.1.0",
  "description": "AI Agent 桌面应用 — 基于 Electron + Fastify + AG-UI 协议",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:server": "pnpm --filter agent-server dev",
    "dev": "pnpm --filter agent-server dev",
    "build:desktop": "pnpm --filter desktop build",
    "build:server": "pnpm --filter agent-server build",
    "build": "pnpm build:server && pnpm build:desktop",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "test:desktop": "pnpm --filter desktop test",
    "test:server": "pnpm --filter agent-server test",
    "test:packages": "pnpm --filter @repo/shared test && pnpm --filter @repo/protocol test",
    "test": "pnpm test:packages && pnpm test:server && pnpm test:desktop",
    "typecheck:desktop": "pnpm --filter desktop typecheck",
    "typecheck:server": "pnpm --filter agent-server exec tsc --noEmit",
    "typecheck:packages": "pnpm --filter @repo/shared exec tsc --noEmit && pnpm --filter @repo/config exec tsc --noEmit && pnpm --filter @repo/protocol exec tsc --noEmit",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:server && pnpm typecheck:desktop",
    "prepare": "husky"
  },
  "keywords": [
    "ai-agent",
    "electron",
    "fastify",
    "ag-ui",
    "copilotkit"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4"
  },
  "packageManager": "pnpm@11.17.0"
}
